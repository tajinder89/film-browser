{
  "name": "film-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A beautiful film browser application with full SSR support powered by React, Vite, and TMDB API",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx server-dev.ts",
    "dev:spa": "vite",
    "build": "npm run build:client && npm run build:server && npm run build:prod-server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:prod-server": "node build-server.mjs",
    "preview": "cross-env NODE_ENV=production tsx server-prod.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "history": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.4",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "sass": "^1.97.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "react",
    "film",
    "browser",
    "movie",
    "tmdb",
    "api",
    "typescript",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/film-browser.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/film-browser/issues"
  },
  "homepage": "https://github.com/yourusername/film-browser#readme"
}
